{
  "name": "loom",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:cli",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist-cli/loom.mjs",
    "generate:layouts": "esbuild scripts/generate-cpu-layouts.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/generate-cpu-layouts.mjs && node node_modules/.cache/generate-cpu-layouts.mjs",
    "fixture:course": "esbuild scripts/course-fixture.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/course-fixture.mjs && node node_modules/.cache/course-fixture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "idb": "^8.0.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.25.0"
  },
  "bin": {
    "loom": "dist-cli/loom.mjs"
  },
  "files": [
    "dist-cli",
    "README.md",
    "docs/CLI.md"
  ],
  "engines": {
    "node": ">=24"
  }
}
